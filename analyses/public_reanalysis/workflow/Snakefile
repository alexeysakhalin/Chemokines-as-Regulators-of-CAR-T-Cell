rule longitudinal_extension:
    input:
        downloaded=rules.fetch_longitudinal.output,
        gse197268_crosswalk="config/gse197268_sample_crosswalk.tsv",
        gse162975_crosswalk="config/gse162975_technical_crosswalk.tsv",
        gse273170_crosswalk="config/gse273170_crosswalk.tsv",
        contrasts="config/longitudinal_contrasts.tsv",
    output:
        "results/longitudinal_extension/local/SHA256SUMS"
    shell:
        "PYTHONHASHSEED=20260902 python scripts/run_longitudinal_extension.py "
        "--gse197268-dir data/raw/GSE197268 "
        "--gse197268-obs data/raw/GSE197268/Fig1_CART_global_obs.csv "
        "--gse197268-subtype data/raw/GSE197268/Fig2_ALLT_CD_classifications.txt "
        "--gse162975-matrix data/raw/GSE162975/GSE162975_CART_BALL_UMI.csv.gz "
        "--gse235760-h5ad "
        "data/raw/GSE235760/2aad61a0-31b8-41f5-8b8a-dbd971269f7b.h5ad "
        "--gse273170-archive data/raw/GSE273170/GSE273170_RAW.tar "
        "--output-dir results/longitudinal_extension/local --seed 20260902"
